# 模板：复制为 creds.env 并填入真实值（creds.env 已被 .gitignore，本模板文件不填真实值）
DB_HOST=''
DB_PORT='3306'
DB_USER=''
DB_PASS=''
GATEWAY=''
# 旧 TOKEN 字段仅作兼容兜底；正常由 scripts/auth.sh 自动登录和缓存
TOKEN=''
UAT_TOKEN=''
# 招采/云采业务接口自动登录（账号在 test/UAT 复用；token 由脚本缓存，不必手填）
SCM_ADMIN_USER=''
SCM_ADMIN_PASS=''
SCM_SUPPLIER_USER=''
SCM_SUPPLIER_PASS=''
# 别名规则：SCM_<别名大写>_USER / SCM_<别名大写>_PASS，加一对就多一个别名，
# scripts/perm.sh 和 scripts/api.sh --account <别名> 自动识别，不用改代码。
SCM_BUYER_USER=''   # 普通采购员，用来当"编制/审批必须不同人"里的第二个人
SCM_BUYER_PASS=''
SCM_TEST_PROCURE_GATEWAY=''
SCM_TEST_CLOUD_GATEWAY=''
SCM_UAT_PROCURE_GATEWAY=''
SCM_UAT_CLOUD_GATEWAY=''
K8S_URL=''
K8S_USER=''
K8S_PASS=''
