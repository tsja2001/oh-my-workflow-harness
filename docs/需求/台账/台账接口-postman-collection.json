  "item": [
    {
      "name": "1. 查询分页列表",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json, text/plain, */*" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": {},\n  \"pageNum\": 1,\n  \"pageSize\": 10\n}"
        },
        "url": {
          "raw": "http://10.0.54.16:32740/gateway/e/business/source/collectionDailyAmountLedger/queryPageList",
          "protocol": "http",
          "host": ["10", "0", "54", "16"],
          "port": "32740",
          "path": ["gateway", "e", "business", "source", "collectionDailyAmountLedger", "queryPageList"]
        },
        "description": "分页查询台账列表。model里可选过滤字段：ledgerNo(流水号模糊)、executeUnitCode、purchaseCompanyCode、categoryCode、buCode、statisticDateArr(日期区间)"
      }
    },
    {
      "name": "1. 查询分页列表（带条件+导出）",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json, text/plain, */*" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": {\n    \"executeUnitCode\": \"JDGS\",\n    \"categoryCode\": \"1501\",\n    \"statisticDateArr\": [\"2026-07-01\", \"2026-07-10\"]\n  },\n  \"pageNum\": 1,\n  \"pageSize\": 10\n}"
        },
        "url": {
          "raw": "http://10.0.54.16:32740/gateway/e/business/source/collectionDailyAmountLedger/queryPageList",
          "protocol": "http",
          "host": ["10", "0", "54", "16"],
          "port": "32740",
          "path": ["gateway", "e", "business", "source", "collectionDailyAmountLedger", "queryPageList"]
        },
        "description": "带查询条件的示例。如需导出Excel，在前端发送时增加 exportRequest/exportTemplateCode/exportFileName 字段"
      }
    },
    {
      "name": "2. 新增台账",
