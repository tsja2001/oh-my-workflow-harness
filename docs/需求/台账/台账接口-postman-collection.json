          { "key": "Accept", "value": "application/json, text/plain, */*" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"executeUnitCode\": \"JDGS\",\n  \"executeUnitName\": \"机电公司\",\n  \"categoryCode\": \"1501\",\n  \"categoryName\": \"钢材\",\n  \"statisticDate\": \"2026-07-10\",\n  \"purchaseCompanyCode\": \"TSFGS\",\n  \"purchaseCompanyName\": \"唐山分公司\",\n  \"taxAmount\": 12800.50,\n  \"buCode\": \"SNJT\",\n  \"buName\": \"水泥集团\"\n}"
        },
        "url": {
          "raw": "http://10.0.54.16:32740/gateway/e/business/source/collectionDailyAmountLedger/add",
          "protocol": "http",
          "host": ["10", "0", "54", "16"],
          "port": "32740",
          "path": ["gateway", "e", "business", "source", "collectionDailyAmountLedger", "add"]
        },
        "description": "新增台账（录入后直接发布）。返回生成的流水号。必填：executeUnitCode/Name, categoryCode/Name, statisticDate, purchaseCompanyCode/Name, taxAmount"
      }
    },
