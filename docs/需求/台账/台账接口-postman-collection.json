          "raw": "{\n  \"ledgerId\": \"2075106985478504449\",\n  \"executeUnitCode\": \"JDGS\",\n  \"executeUnitName\": \"机电公司\",\n  \"categoryCode\": \"1501\",\n  \"categoryName\": \"钢材\",\n  \"statisticDate\": \"2026-07-10\",\n  \"purchaseCompanyCode\": \"TSFGS\",\n  \"purchaseCompanyName\": \"唐山分公司\",\n  \"taxAmount\": 9999.99,\n  \"buCode\": \"SNJT\",\n  \"buName\": \"水泥集团\"\n}"
